<launch>
  <!--
    The sites of the X30, without a map: site_manager_node and route_recorder_node. A site is
    a folder of routes and tags, in the frame of the odometry's start.
      params_file:   overrides of config/mapping.yaml, the same layout: one section per node
      robot_params:  the robot profile, loaded as robot/ here (empty: already on the server)
      sites_dir:     the sites directory of both nodes (empty: from the files)
      site:          the site to load at start (empty: from the files, or the last run's)
      create_site:   create `site` at start when it is missing (empty: from the files, true)
  -->
  <arg name="params_file" default=""/>
  <arg name="robot_params" default=""/>
  <arg name="sites_dir" default=""/>
  <arg name="site" default=""/>
  <arg name="create_site" default=""/>
  <arg name="respawn" default="true"/>
  <arg name="output" default="screen"/>

  <rosparam if="$(eval arg('robot_params') != '')" command="load" ns="robot"
            file="$(arg robot_params)"/>
  <rosparam command="load" file="$(find x30_mapping)/config/mapping.yaml"/>
  <rosparam if="$(eval arg('params_file') != '')" command="load" file="$(arg params_file)"/>

  <group if="$(eval arg('sites_dir') != '')">
    <param name="site_manager_node/sites_dir" value="$(arg sites_dir)"/>
    <param name="route_recorder_node/sites_dir" value="$(arg sites_dir)"/>
  </group>
  <param if="$(eval arg('site') != '')" name="site_manager_node/site" value="$(arg site)"/>
  <param if="$(eval arg('create_site') != '')" name="site_manager_node/create_site"
         type="bool" value="$(arg create_site)"/>

  <node pkg="x30_mapping" type="site_manager_node" name="site_manager_node"
        output="$(arg output)" respawn="$(arg respawn)" respawn_delay="2"/>
  <node pkg="x30_mapping" type="route_recorder_node" name="route_recorder_node"
        output="$(arg output)" respawn="$(arg respawn)" respawn_delay="2"/>
</launch>
