+    def linear_holonomic_model(self, nom_state, nom_u, dt):
+
+        '''
+        body velocity (vx, vy) and yaw rate w, linearized at the nominal heading and speeds:
+            x' = vx cos(phi) - vy sin(phi), y' = vx sin(phi) + vy cos(phi), phi' = w
+        '''
+
+        phi = nom_state[2, 0]
+        vx, vy = nom_u[0, 0], nom_u[1, 0]
+
+        dx_dphi = -vx * sin(phi) - vy * cos(phi)
+        dy_dphi = vx * cos(phi) - vy * sin(phi)
+
+        A = torch.Tensor([ [1, 0, dx_dphi * dt], [0, 1, dy_dphi * dt], [0, 0, 1] ])
+
+        B = torch.Tensor([ [cos(phi) * dt, -sin(phi) * dt, 0], [sin(phi) * dt, cos(phi) * dt, 0],
+                        [ 0, 0, dt ] ])
+
+        C = torch.Tensor([ [ -phi * dx_dphi * dt ], [ -phi * dy_dphi * dt ],
+                        [ 0 ]])
+
+        return to_device(A), to_device(B), to_device(C)
+
     def cal_vertices_from_length_width(self, length, width, wheelbase=None):
