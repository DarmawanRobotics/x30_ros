@@ -68,7 +68,7 @@ class InitialPath:
     def generate_nom_ref_state(self, state: np.ndarray, cur_vel_array: np.ndarray, ref_speed: float):
         """
         state: current state of the robot, shape (3, 1)
-        cur_vel_array: current velocity array of the robot, shape (2, T)
+        cur_vel_array: current velocity array of the robot, shape (2, T); (3, T) for holonomic
         """
         state = state[:3]
 
@@ -396,6 +396,9 @@ class InitialPath:
         elif self.robot.kinematics == "omni":
             next_state = self.omni_model(robot_state, vel, sample_time)
 
+        elif self.robot.kinematics == "holonomic":
+            next_state = self.holonomic_model(robot_state, vel, sample_time)
+
         return next_state
 
     def ackermann_model(self, car_state, vel, wheel_base, sample_time):
@@ -443,6 +446,19 @@ class InitialPath:
        
         return next_state
 
+    def holonomic_model(self, robot_state, vel, sample_time):
+
+        assert robot_state.shape == (3, 1) and vel.shape == (3, 1)
+
+        phi = robot_state[2, 0]
+        vx, vy, w = vel[0, 0], vel[1, 0], vel[2, 0]
+
+        ds = np.array([[vx * cos(phi) - vy * sin(phi)], [vx * sin(phi) + vy * cos(phi)], [w]])
+
+        next_state = robot_state + ds * sample_time
+
+        return next_state
+
     @property
     def cur_waypoints(self):
         return self.waypoints
