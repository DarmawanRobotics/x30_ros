+    def control_bound(self, value, name):
+
+        '''
+        a bound per control value: (control_dim, 1); the default [inf, inf] fits any kinematics
+        '''
+
+        bound = np.c_[value] if isinstance(value, list) else np.asarray(value, dtype=float)
+        bound = bound.reshape(-1, 1).astype(float)
+
+        if bound.shape[0] != self.control_dim and np.all(np.isinf(bound)):
+            bound = np.full((self.control_dim, 1), inf)
+
+        if bound.shape[0] != self.control_dim:
+            raise ValueError(f"{name} of a {self.kinematics} robot needs {self.control_dim} values, got {bound.shape[0]}")
+
+        return bound
+
