<launch>
  <!--
    Teach and repeat end to end on the simulated X30 (x30_sim): bringup.launch with sim:=true,
    the control mux, the sector scans, the odometry monitor, localization, the sites,
    navigation and health. No map: the robot is localized at the odometry start; the operator
    teaches a route on the stick (REMOTE) and the follower repeats it (AUTO). Every run draws
    its site in a new directory.
  -->
  <arg name="sites_dir" default="/tmp/x30_stack_odometry/$(anon sites)"/>
  <include file="$(find x30_bringup)/launch/bringup.launch">
    <arg name="sim" value="true"/>
    <arg name="site" value="yard"/>
    <arg name="sites_dir" value="$(arg sites_dir)"/>
    <arg name="control" value="true"/>
    <arg name="perception" value="true"/>
    <arg name="odometry" value="true"/>
    <arg name="localization" value="true"/>
    <arg name="mapping" value="true"/>
    <arg name="navigation" value="true"/>
    <arg name="health" value="true"/>
  </include>
  <!-- what the nodes keep across runs (site, last route, trip) stays in this run's directory:
       catkin runs the rostests in parallel -->
  <param name="site_manager_node/state_file" value="$(arg sites_dir)/state/site"/>
  <param name="path_loader_node/remember_file" value="$(arg sites_dir)/state/last_route"/>
  <param name="odometry_monitor_node/trip/file" value="$(arg sites_dir)/state/trip.json"/>
  <test test-name="stack_odometry" pkg="x30_bringup" type="odometry_check.py" time-limit="300"/>
</launch>
