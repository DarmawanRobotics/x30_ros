<launch>
  <!--
    The X30 robot package: x30_driver and robot_state_publisher with the URDF in one namespace,
    and the robot profile of the stack (robot/, global).
      params_file / overrides_file: the driver's parameters (see x30_driver/launch/driver.launch)
      robot_params: the robot profile (config/robot.yaml)
      control:      the control mux, the only publisher of <namespace>/cmd_vel (x30_control)
      perception:   the LiDAR sector scans for the protective field (x30_perception)
      leg_odom_tf:  the driver publishes odom -> base_link (leg odometry, roll and pitch from the
                    IMU), for the scans' leveling when no other odometry owns that transform
      lidar_frame / lidar_pose: base_link -> the frame of /livox/lidar ("x y z yaw pitch roll",
                    m and rad): check it on the robot (x30_perception README) before relying
                    on the scans
      rviz: RViz with the robot model
  -->
  <arg name="namespace" default="x30"/>
  <arg name="params_file" default="$(find x30_driver)/config/driver_params.yaml"/>
  <arg name="overrides_file" default=""/>
  <arg name="robot_params" default="$(find x30_bringup)/config/robot.yaml"/>
  <arg name="control" default="false"/>
  <arg name="perception" default="false"/>
  <arg name="leg_odom_tf" default="false"/>
  <arg name="lidar_frame" default="livox_frame"/>
  <arg name="lidar_pose" default="0 0 0 0 0 0"/>
  <arg name="rviz" default="false"/>

  <rosparam command="load" ns="robot" file="$(arg robot_params)"/>

  <include file="$(find x30_driver)/launch/driver.launch">
    <arg name="namespace" value="$(arg namespace)"/>
    <arg name="params_file" value="$(arg params_file)"/>
    <arg name="overrides_file" value="$(arg overrides_file)"/>
  </include>
  <!-- after the driver's files: the last setting of a parameter wins -->
  <param if="$(arg leg_odom_tf)" name="$(arg namespace)/x30_driver/publish_tf" value="true"/>

  <include file="$(find x30_description)/launch/description.launch">
    <arg name="namespace" value="$(arg namespace)"/>
  </include>

  <include if="$(arg control)" file="$(find x30_control)/launch/control.launch">
    <arg name="cmd_vel_topic" value="/$(arg namespace)/cmd_vel"/>
  </include>

  <group if="$(arg perception)">
    <include file="$(find x30_perception)/launch/perception.launch"/>
    <node pkg="tf2_ros" type="static_transform_publisher" name="lidar_mount"
          args="$(arg lidar_pose) base_link $(arg lidar_frame)"/>
  </group>

  <node if="$(arg rviz)" ns="$(arg namespace)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find x30_description)/rviz/x30.rviz"/>
</launch>
