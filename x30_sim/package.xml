<?xml version="1.0"?>
<package format="3">
  <name>x30_sim</name>
  <version>0.15.0</version>
  <description>The X30 in software for the whole stack (the ROS Noetic port of dharma_sim): a kinematic body behind x30_driver's topics and services, the four Livox Mid-360 ray-cast into /livox/lidar, the body IMU, a drifting FAST-LIO stand-in and leg odometry, latency and dropouts from seeded scenarios, worlds and ready sites for end-to-end tests. No Gazebo, no GPU.</description>
  <maintainer email="darmawandeveloper@gmail.com">Agus Darmawan</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/DarmawanRobotics/x30_ros</url>

  <buildtool_depend>catkin</buildtool_depend>
  <buildtool_depend>python3-setuptools</buildtool_depend>

  <build_depend>x30_utils</build_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rosbash</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>x30_msgs</exec_depend>
  <exec_depend>x30_utils</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>roslaunch</test_depend>
  <test_depend>x30_perception</test_depend>
</package>
