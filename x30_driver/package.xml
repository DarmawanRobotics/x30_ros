<?xml version="1.0"?>
<package format="3">
  <name>x30_driver</name>
  <version>0.2.0</version>
  <description>ROS Noetic driver for the Deep Robotics Jueying X30 over its motion host's UDP protocol (API V1.0.5): cmd_vel as axis commands, odometry, IMU, joint states, battery, robot state and Trigger services, with the perception host's elevation map and autonomous charging.</description>
  <maintainer email="darmawandeveloper@gmail.com">Agus Darmawan</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/DarmawanRobotics/x30_ros</url>

  <buildtool_depend>catkin</buildtool_depend>
  <buildtool_depend>python3-setuptools</buildtool_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>python3-nose</test_depend>
  <test_depend>roslaunch</test_depend>
  <test_depend>rostest</test_depend>
</package>
