<launch>
  <!--
    The navigation of the X30 on routes, without a map: site_manager_node and
    route_recorder_node (the sites, folders of routes and tags in the frame of the odometry's
    start, and route teaching), path_loader_node, path_follower_node, obstacle_avoidance_node
    and docking_node. They command the control mux
    (control/nav_cmd_vel), never the robot's cmd_vel.
      params_file:   overrides of config/navigation.yaml, the same layout: one section per node
      robot_params:  the robot profile, loaded as robot/ here (empty: already on the server)
      battery_topic: the robot's sensor_msgs/BatteryState (x30_driver)
      odom_topic:    the robot's nav_msgs/Odometry with the body twist (x30_driver)
      sites_dir:     the sites directory of the nodes, when set
      site:          the site to load at start, when set (else the last run's)
      create_site:   create `site` at start when it is missing, when set (the file's: true)
      route:         path_loader_node's route at start, when set
      docking:       start docking_node
      controller:    the path follower's controller, when set (else navigation.yaml's)
      dune_checkpoint: the DUNE model of controller neupan (default: the X30's, models/)
      python:        the path follower's interpreter (default: $X30_PYTHON, else the system's):
                     the venv of tools/install_neupan.sh for controller neupan
  -->
  <arg name="params_file" default=""/>
  <arg name="robot_params" default=""/>
  <arg name="battery_topic" default="/x30/battery"/>
  <arg name="odom_topic" default="/x30/odom"/>
  <arg name="sites_dir" default=""/>
  <arg name="site" default=""/>
  <arg name="create_site" default=""/>
  <arg name="route" default=""/>
  <arg name="docking" default="true"/>
  <arg name="controller" default=""/>
  <arg name="dune_checkpoint" default="$(find x30_navigation)/models/dune_x30.pth"/>
  <arg name="python" default="$(optenv X30_PYTHON)"/>
  <arg name="respawn" default="true"/>
  <arg name="output" default="screen"/>

  <rosparam if="$(eval arg('robot_params') != '')" command="load" ns="robot"
            file="$(arg robot_params)"/>
  <rosparam command="load" file="$(find x30_navigation)/config/navigation.yaml"/>
  <!-- before params_file, which may give another model -->
  <param name="path_follower_node/neupan/dune_checkpoint" value="$(arg dune_checkpoint)"/>
  <rosparam if="$(eval arg('params_file') != '')" command="load" file="$(arg params_file)"/>
  <param if="$(eval arg('controller') != '')" name="path_follower_node/controller"
         value="$(arg controller)"/>
  <group if="$(eval arg('sites_dir') != '')">
    <param name="site_manager_node/sites_dir" value="$(arg sites_dir)"/>
    <param name="route_recorder_node/sites_dir" value="$(arg sites_dir)"/>
    <param name="path_loader_node/sites_dir" value="$(arg sites_dir)"/>
  </group>
  <param if="$(eval arg('site') != '')" name="site_manager_node/site" value="$(arg site)"/>
  <param if="$(eval arg('create_site') != '')" name="site_manager_node/create_site"
         type="bool" value="$(arg create_site)"/>
  <param if="$(eval arg('route') != '')" name="path_loader_node/route" value="$(arg route)"/>

  <node pkg="x30_navigation" type="site_manager_node" name="site_manager_node"
        output="$(arg output)" respawn="$(arg respawn)" respawn_delay="2"/>
  <node pkg="x30_navigation" type="route_recorder_node" name="route_recorder_node"
        output="$(arg output)" respawn="$(arg respawn)" respawn_delay="2"/>
  <node pkg="x30_navigation" type="path_loader_node" name="path_loader_node"
        output="$(arg output)" respawn="$(arg respawn)" respawn_delay="2"/>
  <node pkg="x30_navigation" type="path_follower_node" name="path_follower_node"
        output="$(arg output)" respawn="$(arg respawn)" respawn_delay="1"
        launch-prefix="$(arg python)">
    <remap from="battery" to="$(arg battery_topic)"/>
    <remap from="odom" to="$(arg odom_topic)"/>
  </node>
  <node pkg="x30_navigation" type="obstacle_avoidance_node" name="obstacle_avoidance_node"
        output="$(arg output)" respawn="$(arg respawn)" respawn_delay="1"/>
  <node if="$(arg docking)" pkg="x30_navigation" type="docking_node" name="docking_node"
        output="$(arg output)" respawn="$(arg respawn)" respawn_delay="1">
    <remap from="battery" to="$(arg battery_topic)"/>
  </node>
</launch>
